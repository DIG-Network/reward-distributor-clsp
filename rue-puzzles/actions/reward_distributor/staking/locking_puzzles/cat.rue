// cat.rue by yakuhito
// Allows a certain CAT to be staked. Share number is equal to the number of CATs.

// This is a staking puzzle - output is (new_active_shares . output_conditions).
// Ephemeral_State & Entry_Custody_Puzzle_Hash are Truths verified and passed by 'stake.clsp'.

import super::super::super::super::reward_distributor::*;
import super::super::super::super::slot::*;
import super::stake::LockPuzzleOutput;
import std::offer::*;

export type CatMakerSolution = Any;
export type CatMaker = fn(
    inner_puzzle_hash: Bytes32,
    ...solution: CatMakerSolution,
) -> Bytes32;

export fn main(
    CAT_MAKER: CatMaker,
    OFFER_MOD_HASH: Bytes32,
    MY_P2_PUZZLE_HASH: Bytes32,
    DEPOSIT_SLOT_1ST_CURRY_HASH: Bytes32,
    Ephemeral_State: Int,
    Entry_Custody_Puzzle_Hash: Bytes32,
    my_id: Bytes32,
    cat_amount: Int,
    ...cat_maker_solution: CatMakerSolution,
) -> LockPuzzleOutput {
    assert cat_amount > 0;

    let offer_cat_full_puzzle_hash = CAT_MAKER(
        OFFER_MOD_HASH, ...cat_maker_solution
    );

    let offer_announcement = tree_hash(NotarizedPayment {
        nonce: tree_hash((Ephemeral_State, my_id)),
        payments: [Payment {
            puzzle_hash: MY_P2_PUZZLE_HASH,
            amount: cat_amount,
            memos: Memos { value: [
                tree_hash((Entry_Custody_Puzzle_Hash, MY_P2_PUZZLE_HASH))
            ] },
        }],
    });

    let announcement_id = sha256(
        offer_cat_full_puzzle_hash + offer_announcement
    );

    LockPuzzleOutput {
        newly_locked_shares: cat_amount,
        locking_conditions: [
            create_slot_with_hint(
                DEPOSIT_SLOT_1ST_CURRY_HASH,
                tree_hash(DepositSlotValue {
                    payout_puzzle_hash: Entry_Custody_Puzzle_Hash,
                    shares: cat_amount,
                    launcher_id_or_cat_amount: cat_amount,
                }),
                Entry_Custody_Puzzle_Hash,
            ),
            AssertPuzzleAnnouncement {
                id: announcement_id,
            },
            CreatePuzzleAnnouncement {
                message: "l" + announcement_id,
            },
            AssertMyCoinId {
                coin_id: my_id,
            },
        ]
    }
}
