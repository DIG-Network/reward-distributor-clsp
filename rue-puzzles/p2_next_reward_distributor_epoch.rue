// p2_next_reward_distributor_epoch.clsp by yakuhito
// Coins locked with this puzzle are committed to the next epoch
//    of a reward distributor whose details are curried in.

// To prevent two coins locked in this puzzle (with the same amount) from being
//   spent using one announcement (an attacker would claim half the value - even
//   more if more coins with the same amount exist), this coin's id is used as a
//   unique identifier for the commitment. To do that, instead of using the
//   clawback puzzle hash whose hash is curried in, the actual clawback puzzle
//   will be the provided one wrapped in a nonce layer, with the nonce being this
//   coin's id.

import reward_distributor::slot_value_hash_part;

export fn main(
    SINGLETON_MOD_HASH: Bytes32,
    NONCE_MOD_HASH: Bytes32,
    CLAWBACK_INNER_PUZZLE_HASH_HASH: Bytes32, // (sha256 1 clawback_puzzle)
    REWARD_DISTRIBUTOR_SINGLETON_STRUCT_HASH: Bytes32, // (sha256tree REWARD_DISTRIBUTOR_SINGLETON_STRUCT)
    REWARD_DISTRIBUTOR_FIRST_EPOCH_START: Int,
    REWARD_DISTRIBUTOR_EPOCH_SECONDS: Int,
    next_epoch_start: Int,
    my_id: Bytes32,
    my_amount: Int,
    ...reward_distributor_inner_puzzle_hash: Bytes32,
) -> (List<Condition>) {
    assert (next_epoch_start - REWARD_DISTRIBUTOR_FIRST_EPOCH_START) % REWARD_DISTRIBUTOR_EPOCH_SECONDS == 0;

    let reward_distributor_puzzle_hash = curry_tree_hash(SINGLETON_MOD_HASH, [
        REWARD_DISTRIBUTOR_SINGLETON_STRUCT_HASH,
        reward_distributor_inner_puzzle_hash
    ]);

    let clawback_puzzle_hash = curry_tree_hash(NONCE_MOD_HASH, [
        tree_hash_atom(my_id),
        CLAWBACK_INNER_PUZZLE_HASH_HASH
    ]);

    let commitment_slot_value_hash = slot_value_hash_part(
        next_epoch_start,
        clawback_puzzle_hash,
        my_amount
    );

    [
        // Next epoch cannot possibly have started
        AssertBeforeSecondsAbsolute {
            seconds: next_epoch_start,
        },
        // Next epoch is indeed the next one (previous epoch or older is ongoign)
        AssertSecondsAbsolute {
            seconds: next_epoch_start - REWARD_DISTRIBUTOR_EPOCH_SECONDS,
        },
        // Announcement generated by the reward distributor when there's a commitment
        AssertPuzzleAnnouncement {
            id: sha256(reward_distributor_puzzle_hash + "c" + commitment_slot_value_hash)
        },
        // Impossible to lie about this coin's amount
        AssertMyAmount {
            amount: my_amount,
        },
        // Impossible to lie about this coin's id
        AssertMyCoinId {
            coin_id: my_id,
        }
    ]
}
